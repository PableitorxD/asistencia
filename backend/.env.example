# ============================================================
#  CONFIGURACIÓN ÚNICA DEL SISTEMA DE ASISTENCIA
#  1) Copia este archivo:   cp .env.example backend/.env
#     (en Windows: copy .env.example backend\.env)
#  2) Cambia SOLO los valores de abajo. No hay que tocar código.
# ============================================================

# --- Servidor ---
PORT=3000

# URL pública del backend que usará el frontend.
#  - Vacío  -> el frontend usa el mismo servidor (recomendado: abres http://localhost:3000)
#  - Si el frontend está en OTRO lugar (Live Server, hosting...), pon aquí la URL completa:
#      API_URL=http://localhost:3000
#      API_URL=https://server-backend.brazilsouth.cloudapp.azure.com
API_URL=

# Orígenes permitidos por CORS (separados por coma). * = cualquiera.
CORS_ORIGIN=*

# --- Base de datos ---
DB_PATH=./asistencia.db

# --- Seguridad del panel de administrador ---
ADMIN_KEY=admin123

# --- Reglas de asistencia ---
# Zona horaria del servidor (la hora de marcado la pone el servidor, no el navegador)
TZ_APP=America/La_Paz
# true  = valida horario: antes de tiempo/terminada no deja marcar y pasada la tolerancia queda ATRASO
# false = cualquier hora del día de clase cuenta como PUNTUAL
VALIDAR_HORARIO=false
TOLERANCIA_MIN=15
ANTICIPO_MIN=30
